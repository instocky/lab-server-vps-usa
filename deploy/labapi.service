[Unit]
Description=labapi (test API for ssh -R tunnel)
After=network.target

[Service]
Type=simple
User=adlab
# путь к клону репо на lab-server
WorkingDirectory=/home/adlab/lab-server-vps-usa
Environment=PATH=/home/adlab/lab-server-vps-usa/.venv/bin
ExecStart=/home/adlab/lab-server-vps-usa/.venv/bin/uvicorn labapi.main:app --host 127.0.0.1 --port 8081
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
