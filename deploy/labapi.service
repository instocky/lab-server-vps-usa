[Unit]
Description=labapi (test API for ssh -R tunnel)
After=network.target

[Service]
Type=simple
# заменить %h/labapi на абсолютный путь, если сервис запускает не ваш пользователь
WorkingDirectory=%h/labapi
Environment=PATH=%h/labapi/.venv/bin
ExecStart=%h/labapi/.venv/bin/uvicorn labapi.main:app --host 127.0.0.1 --port 8081
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
