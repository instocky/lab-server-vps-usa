[Unit]
Description=labapi (test API for ssh -R tunnel)
After=network.target

[Service]
Type=simple
# развернуть репо в ~/lab-server-vps-usa; %h = домашний каталог пользователя
WorkingDirectory=%h/lab-server-vps-usa
Environment=PATH=%h/lab-server-vps-usa/.venv/bin
ExecStart=%h/lab-server-vps-usa/.venv/bin/uvicorn labapi.main:app --host 127.0.0.1 --port 8081
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
